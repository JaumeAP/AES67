<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AES67 Controller</string>
    <key>CFBundleDisplayName</key>
    <string>AES67 Controller</string>
    <key>CFBundleIdentifier</key>
    <string>com.aes67.controller</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>AES67Controller</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Multicast and mDNS: this application listens for SAP announcements and
         browses _rtsp._tcp itself, which is what makes it usable on a machine
         where the driver was never installed. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>AES67 Controller finds audio sessions announced on your local network and routes them between devices.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_rtsp._tcp</string>
        <string>_nmos-node._tcp</string>
        <string>_nmos-register._tcp</string>
    </array>
</dict>
</plist>
