<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for aes67ptpd.

  One PTP engine for the host: it owns the PTP sockets, survives coreaudiod
  restarts and plugin reloads, and publishes offset and path delay on
  /var/run/aes67ptpd.sock for the driver (and anything else) to read.

  Registered by AES67Manager.app with SMAppService, which is how an app on
  macOS 13 and later installs a daemon: this file ships inside the app at
  Contents/Library/LaunchDaemons/ and launchd runs it from there. There is
  nothing to copy into /Library/LaunchDaemons and nothing to bootstrap by
  hand; the app's Uninstall button unregisters it.

  It is a LaunchDaemon for lifecycle, not for privilege: on current macOS an
  unprivileged process binds UDP 319/320 without trouble. It starts as root
  only so that it can create the status socket in /var/run, and drops to
  "nobody" as soon as that and the PTP sockets exist — the packet parsing,
  which is what runs for the life of the machine, never runs as root. Change
  --interface to the port carrying the AES67 traffic.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aes67driver.ptpd</string>

    <!-- Registered by the Manager app through SMAppService, so launchd runs
         the executable from inside the app bundle: BundleProgram is relative
         to AES67Manager.app, and nothing is copied to /usr/local. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/aes67ptpd</string>

    <key>ProgramArguments</key>
    <array>
        <string>aes67ptpd</string>
        <string>--interface</string>
        <string>en0</string>
        <string>--domain</string>
        <string>0</string>
        <string>--socket</string>
        <string>/var/run/aes67ptpd.sock</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Media timing, not a batch job: ask not to be throttled. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/var/log/aes67ptpd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/aes67ptpd.log</string>
</dict>
</plist>
